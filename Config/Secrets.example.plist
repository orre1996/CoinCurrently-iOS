<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to Config/Secrets.plist and fill in your values.
  Config/Secrets.plist is gitignored and must be added to the CoinCurrently,
  CryptoWidgetExtension, and CoinCurrentlyWatch targets in Xcode.
-->
<plist version="1.0">
<dict>
	<!--
	  Market routes are "{API_BASE_URL}/crypto/api/v3/...". API_BASE_URL is your backend.
	  Coin detail, OHLC, and market charts for users without Pro call
	  https://api.coingecko.com/api/v3 directly.
	  No trailing slash. A placeholder lets the app launch. Coin detail, OHLC,
	  market charts, and the fear and greed index can still load. Toplists, news,
	  search, and alerts stay empty until this points at a backend.
	-->
	<key>API_BASE_URL</key>
	<string>https://api.example.com</string>
	<key>BACKEND_API_KEY</key>
	<string>your-backend-api-key</string>
	<key>REVENUECAT_PRODUCTION_API_KEY</key>
	<string>appl_your_revenuecat_production_key</string>
	<key>REVENUECAT_TEST_API_KEY</key>
	<string>test_your_revenuecat_test_key</string>
	<key>APTABASE_APP_KEY</key>
	<string>A-XX-0000000000</string>
</dict>
</plist>

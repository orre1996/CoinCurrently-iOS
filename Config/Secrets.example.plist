<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Optional. Copy this file to Config/Secrets.plist to point the app at your
  backend or to turn on Aptabase. Config/Secrets.plist is gitignored.
  Without it, market data uses CoinGecko's keyless API.
-->
<plist version="1.0">
<dict>
	<!--
	  Optional. Your backend, with no trailing slash.
	  Leave this placeholder, or omit Secrets.plist, and market routes call
	  CoinGecko's keyless API at https://api.coingecko.com/api/v3.
	  Set a real URL to proxy markets through "{API_BASE_URL}/crypto/api/v3/...".
	  Price alerts, gas fees, wallet import, and the other first-party routes
	  still need that backend.
	-->
	<key>API_BASE_URL</key>
	<string>https://api.example.com</string>
	<key>BACKEND_API_KEY</key>
	<string>your-backend-api-key</string>
	<key>APTABASE_APP_KEY</key>
	<string>A-XX-0000000000</string>
</dict>
</plist>

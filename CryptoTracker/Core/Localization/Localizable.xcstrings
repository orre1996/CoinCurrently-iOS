        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La confianza sube y aumentan las compras. Sé selectivo y evita perseguir las subidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",

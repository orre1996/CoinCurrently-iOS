    "Chart type selector. Swipe up or down to change chart type." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محدد نوع المخطط. اسحب لأعلى أو لأسفل لتغيير النوع."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Избор на тип графика. Плъзнете нагоре или надолу, за да го смените."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výběr typu grafu. Přejetím nahoru nebo dolů změníte typ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagramtypevælger. Stryg op eller ned for at skifte type."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagrammtypauswahl. Nach oben oder unten wischen, um den Typ zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλογέας τύπου γραφήματος. Σύρετε πάνω ή κάτω για αλλαγή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selector de tipo de gráfico. Desliza hacia arriba o abajo para cambiarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaaviotyypin valitsin. Vaihda tyyppiä pyyhkäisemällä ylös tai alas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélecteur de type de graphique. Balayez vers le haut ou le bas pour changer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בורר סוג תרשים. החלק למעלה או למטה כדי לשנות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चार्ट प्रकार चुनें। बदलने के लिए ऊपर या नीचे स्वाइप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odabir vrste grafikona. Povucite gore ili dolje za promjenu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagramtípus-választó. Húzza fel vagy le a váltáshoz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemilih jenis grafik. Geser ke atas atau ke bawah untuk mengubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

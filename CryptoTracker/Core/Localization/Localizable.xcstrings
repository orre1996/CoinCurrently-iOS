    "Max Supply" : {

    },
    "Measures trading volume and price momentum against recent averages. Strong momentum typically reflects growing market confidence." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس حجم التداول وزخم السعر مقابل المتوسطات الأخيرة. الزخم القوي يعكس عادة ثقة متزايدة في السوق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измерва обем и ценови импулс спрямо скорошните средни. Силният импулс обикновено отразява растяща увереност."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měří objem obchodů a cenové momentum vůči nedávným průměrům. Silné momentum obvykle značí rostoucí důvěru trhu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måler handelsvolumen og prismomentum mod de seneste gennemsnit. Stærkt momentum afspejler typisk stigende markedstillid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst Handelsvolumen und Kursmomentum gegenüber den jüngsten Durchschnitten. Starkes Momentum spiegelt meist wachsendes Vertrauen wider."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μετρά τον όγκο και την ορμή τιμής σε σχέση με πρόσφατους μέσους όρους. Ισχυρή ορμή συνήθως δείχνει αυξανόμενη εμπιστοσύνη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide el volumen y el impulso del precio frente a las medias recientes. Un impulso fuerte suele reflejar más confianza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittaa kaupankäyntivolyymin ja hintamomentumin viimeaikaisiin keskiarvoihin. Vahva momentum kertoo yleensä kasvavasta luottamuksesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesure le volume et la dynamique des prix par rapport aux moyennes récentes. Une forte dynamique reflète en général une confiance croissante."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מודד נפח מסחר ומומנטום מחיר מול ממוצעים אחרונים. מומנטום חזק משקף בדרך כלל ביטחון גובר בשוק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाल के औसत के मुकाबले ट्रेडिंग वॉल्यूम और कीमत की गति मापता है। मजबूत गति आमतौर पर बढ़ते भरोसे को दर्शाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjeri volumen trgovanja i zamah cijene u odnosu na nedavne prosjeke. Jak zamah obično odražava rastuće povjerenje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kereskedési volument és az ármomentumot méri a közelmúlt átlagaihoz képest. Az erős lendület általában növekvő bizalmat tükröz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengukur volume perdagangan dan momentum harga terhadap rata-rata terkini. Momentum kuat biasanya mencerminkan kepercayaan yang tumbuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura volume e momentum del prezzo rispetto alle medie recenti. Un momentum forte riflette di solito una fiducia crescente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出来高と価格モメンタムを最近の平均と比較します。強いモメンタムは市場の自信の高まりを示すことが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래량과 가격 모멘텀을 최근 평균과 비교합니다. 강한 모멘텀은 보통 시장 신뢰가 커지고 있음을 뜻합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matuoja apyvartą ir kainos momentą pagal naujausius vidurkius. Stiprus momentas paprastai rodo augantį pasitikėjimą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måler handelsvolum og prismomentum mot nylige snitt. Sterkt momentum gjenspeiler vanligvis økende markedstillit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meet handelsvolume en prijsmomentum afgezet tegen recente gemiddelden. Sterk momentum wijst meestal op groeiend vertrouwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mierzy wolumen i impet ceny względem ostatnich średnich. Silny impet zwykle oznacza rosnące zaufanie rynku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mede o volume e o momento do preço em relação às médias recentes. Um momento forte costuma refletir confiança crescente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Măsoară volumul și impulsul prețului față de mediile recente. Un impuls puternic reflectă de obicei o încredere în creștere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнивает объём торгов и ценовой импульс с недавними средними. Сильный импульс обычно отражает рост уверенности рынка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meria objem obchodov a cenový moment voči nedávnym priemerom. Silný moment zvyčajne značí rastúcu dôveru trhu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meri obseg trgovanja in cenovni zagon glede na nedavna povprečja. Močan zagon običajno pomeni rastoče zaupanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mäter handelsvolym och prismomentum mot de senaste snitten. Starkt momentum speglar vanligtvis växande marknadsförtroende."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วัดปริมาณซื้อขายและโมเมนตัมราคาเทียบกับค่าเฉลี่ยล่าสุด โมเมนตัมแข็งแกร่งมักสะท้อนความมั่นใจที่เพิ่มขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlem hacmini ve fiyat momentumunu son ortalamalarla ölçer. Güçlü momentum genellikle artan piyasa güvenini yansıtır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вимірює обсяг торгів і ціновий імпульс відносно нещодавніх середніх. Сильний імпульс зазвичай означає зростання впевненості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đo khối lượng giao dịch và đà giá so với trung bình gần đây. Đà mạnh thường phản ánh niềm tin thị trường đang tăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对照近期均值衡量成交量和价格动量。强劲动量通常表示市场信心增强。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對照近期均值衡量成交量和價格動能。強勁動能通常表示市場信心增強。"
          }
        }
      }
    },

    "Confidence is rising and buying activity is increasing. Stay selective and avoid chasing rallies." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الثقة ترتفع ونشاط الشراء يزداد. كن انتقائيًا وتجنب مطاردة الارتفاعات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увереността расте и покупките се увеличават. Бъдете избирателни и не гонете ръстовете."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Důvěra roste a nákupní aktivita se zvyšuje. Buďte vybíraví a nežeňte se za růsty."

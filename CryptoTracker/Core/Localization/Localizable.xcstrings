          "stringUnit" : {
            "state" : "translated",
            "value" : "העסקאות זולות מאוד. זמן אידיאלי להחלפות, להעברות ולאינטראקציה עם חוזים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लेनदेन बेहद सस्ते हैं। स्वैप, ट्रांसफ़र और कॉन्ट्रैक्ट इंटरैक्शन के लिए सही समय।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transakcije su iznimno jeftine. Idealno vrijeme za zamjene, prijenose i interakcije s ugovorima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tranzakciók rendkívül olcsók. Ideális idő swapokhoz, átutalásokhoz és szerződéses műveletekhez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaksi sangat murah. Waktu yang ideal untuk swap, transfer, dan interaksi kontrak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

    "Panic selling is widespread. Long-term investors often accumulate during these periods." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيع الذعر منتشر. كثيرًا ما يراكم المستثمرون طويلي الأجل خلال هذه الفترات."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паническите продажби са широко разпространени. Дългосрочните инвеститори често натрупват в такива периоди."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panikové prodeje jsou rozšířené. Dlouhodobí investoři v těchto obdobích často nakupují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panisk salg er udbredt. Langsigtede investorer akkumulerer ofte i disse perioder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panikverkäufe sind weit verbreitet. Langfristige Anleger kaufen in solchen Phasen oft zu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι πανικόβλητες πωλήσεις είναι διαδεδομένες. Οι μακροπρόθεσμοι επενδυτές συχνά συσσωρεύουν σε αυτές τις περιόδους."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventas por pánico están generalizadas. Los inversores a largo plazo suelen acumular en estos periodos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paniikkimyynnit ovat yleisiä. Pitkäaikaiset sijoittajat kerryttävät usein näinä aikoina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ventes de panique sont généralisées. Les investisseurs de long terme accumulent souvent pendant ces périodes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מכירות פאניקה נפוצות. משקיעים לטווח ארוך צוברים לעיתים קרובות בתקופות אלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घबराहट में बिक्री व्यापक है। दीर्घकालिक निवेशक अक्सर इन अवधियों में जमा करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panična prodaja je raširena. Dugoročni ulagači često akumuliraju u tim razdobljima."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pánikeladás elterjedt. A hosszú távú befektetők gyakran ilyen időszakokban halmoznak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksi jual panik meluas. Investor jangka panjang sering mengakumulasi pada periode ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vendite dettate dal panico sono diffuse. Gli investitori di lungo periodo spesso accumulano in queste fasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パニック売りが広がっています。長期投資家はこの時期に積み増すことが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패닉 매도가 널리 퍼져 있습니다. 장기 투자자는 이 시기에 종종 매집합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panikos pardavimai plačiai paplitę. Ilgalaikiai investuotojai dažnai kaupia tokiais laikotarpiais."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panikksalg er utbredt. Langsiktige investorer akkumulerer ofte i slike perioder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paniekverkopen zijn wijdverbreid. Langetermijnbeleggers kopen in deze periodes vaak bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paniczna wyprzedaż jest powszechna. Długoterminowi inwestorzy często akumulują w takich okresach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As vendas por pânico estão generalizadas. Investidores de longo prazo costumam acumular nesses períodos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vânzările de panică sunt răspândite. Investitorii pe termen lung acumulează adesea în aceste perioade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Панические продажи широко распространены. Долгосрочные инвесторы часто набирают позицию в такие периоды."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panikový predaj je rozšírený. Dlhodobí investori v týchto obdobiach často nakupujú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panična prodaja je razširjena. Dolgoročni vlagatelji v teh obdobjih pogosto kopičijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panikförsäljning är utbredd. Långsiktiga investerare ackumulerar ofta under dessa perioder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การขายเพราะความตื่นตระหนกแพร่หลาย นักลงทุนระยะยาวมักสะสมในช่วงนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panik satışlar yaygın. Uzun vadeli yatırımcılar bu dönemlerde sık sık biriktirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Панічні продажі поширені. Довгострокові інвестори часто накопичують у такі періоди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bán tháo hoảng loạn đang lan rộng. Nhà đầu tư dài hạn thường tích lũy trong giai đoạn này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恐慌性抛售普遍。长期投资者常在这些时期积累。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恐慌性拋售普遍。長期投資者常在這些時期累積。"
          }
        }
      }
    },

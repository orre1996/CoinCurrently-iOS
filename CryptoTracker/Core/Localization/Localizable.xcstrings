    "Weekly surveys are conducted on a polling platform to see what individuals are thinking of the markets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُجرى استطلاعات أسبوعية على منصة تصويت لمعرفة رأي الأفراد في الأسواق."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провеждат се седмични анкети в платформа за допитване, за да се види какво мислят хората за пазарите."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Týdenní průzkumy na hlasovací platformě zjišťují, co si lidé myslí o trzích."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ugentlige undersøgelser på en afstemningsplatform viser, hvad folk tænker om markederne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wöchentliche Umfragen auf einer Abstimmungsplattform zeigen, was Menschen über die Märkte denken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εβδομαδιαίες έρευνες σε πλατφόρμα δημοσκοπήσεων δείχνουν τι σκέφτονται οι άνθρωποι για τις αγορές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hacen encuestas semanales en una plataforma de votación para ver qué piensan las personas de los mercados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viikoittaisilla kyselyillä äänestysalustalla selvitetään, mitä ihmiset ajattelevat markkinoista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des sondages hebdomadaires sur une plateforme de vote montrent ce que les gens pensent des marchés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סקרים שבועיים בפלטפורמת הצבעה בודקים מה אנשים חושבים על השווקים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाजारों के बारे में लोगों की राय जानने के लिए मतदान प्लेटफ़ॉर्म पर साप्ताहिक सर्वे होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjedne ankete na platformi za glasanje pokazuju što ljudi misle o tržištima."
          }

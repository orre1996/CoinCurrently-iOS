        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cautela sul mercato sta aumentando. Cerca asset di qualità a prezzo scontato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "市場全体で警戒が高まっています。割安な優良資産を探してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시장 전반의 경계심이 커지고 있습니다. 할인된 우량 자산을 찾으세요."

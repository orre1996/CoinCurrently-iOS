    "Caution is increasing across the market. Look for discounted quality assets." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحذر يزداد في السوق. ابحث عن أصول جيدة بأسعار مخفضة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предпазливостта на пазара расте. Търсете качествени активи с отстъпка."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obezřetnost na trhu roste. Hledejte kvalitní aktiva se slevou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forsigtigheden stiger på markedet. Kig efter kvalitetsaktiver til nedsat pris."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorsicht am Markt nimmt zu. Suchen Sie nach günstigen Qualitätswerten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επιφυλακτικότητα αυξάνεται στην αγορά. Αναζητήστε ποιοτικά περιουσιακά στοιχεία σε έκπτωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cautela aumenta en el mercado. Busca activos de calidad con descuento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varovaisuus kasvaa markkinoilla. Etsi alennuksessa olevia laadukkaita kohteita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prudence augmente sur le marché. Cherchez des actifs de qualité à prix réduit."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזהירות בשוק גוברת. חפשו נכסים איכותיים במחיר מוזל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाज़ार में सावधानी बढ़ रही है। रियायती अच्छे परिसंपत्तियाँ देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprez na tržištu raste. Tražite kvalitetnu imovinu po sniženoj cijeni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A piaci óvatosság nő. Keressen olcsó, minőségi eszközöket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehati-hatian di pasar meningkat. Cari aset berkualitas yang sedang diskon."

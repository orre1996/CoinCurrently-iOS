    "Tap the star on any coin to add it here and track it easily." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر على النجمة بجانب أي عملة لإضافتها هنا ومتابعتها بسهولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете звездата на монета, за да я добавите тук и да я следите лесно."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na hvězdičku u mince ji přidáte sem a snadno sledujete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på stjernen ved en mønt for at tilføje den her og følge den nemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippen Sie auf den Stern einer Coin, um sie hier hinzuzufügen und leicht zu verfolgen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το αστέρι σε ένα νόμισμα για να το προσθέσετε εδώ και να το παρακολουθείτε εύκολα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la estrella de cualquier moneda para añadirla aquí y seguirla fácilmente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta kolikon tähteä lisätäksesi sen tähän ja seurataksesi sitä helposti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’étoile d’un jeton pour l’ajouter ici et le suivre facilement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקישו על הכוכב של מטבע כדי להוסיף אותו לכאן ולעקוב אחריו בקלות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी कॉइन पर स्टार टैप करके उसे यहाँ जोड़ें और आसानी से ट्रैक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite zvjezdicu na kovanici da je dodate ovdje i jednostavno pratite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson egy érme csillagára, hogy ide adja és könnyen kövesse."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk bintang pada koin untuk menambahkannya di sini dan melacaknya dengan mudah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca la stella di una moneta per aggiungerla qui e seguirla facilmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コインの星をタップすると、ここに追加して簡単に追跡できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코인의 별표를 탭하면 여기에 추가하고 쉽게 추적할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakstelėkite monetos žvaigždutę, kad ją pridėtumėte čia ir lengvai sektumėte."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på stjernen ved en mynt for å legge den til her og følge den enkelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de ster bij een munt om deze hier toe te voegen en eenvoudig te volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij gwiazdkę przy monecie, aby dodać ją tutaj i łatwo śledzić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque na estrela de uma moeda para a adicionar aqui e acompanhá-la facilmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge steaua unei monede ca să o adaugi aici și să o urmărești ușor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на звезду у монеты, чтобы добавить её сюда и легко отслеживать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepnutím na hviezdičku pri minci ju pridáte sem a ľahko sledujete."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapnite zvezdico pri kovancu, da ga dodate sem in preprosto spremljate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på stjärnan vid ett mynt för att lägga till det här och följa det enkelt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะดาวบนเหรียญเพื่อเพิ่มที่นี่และติดตามได้ง่าย"

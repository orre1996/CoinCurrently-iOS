    "Optimism is elevated and pullbacks become more likely. Consider reducing high-risk exposure." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التفاؤل مرتفع ويزداد احتمال التصحيحات. فكّر في تقليل الانكشاف عالي المخاطر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимизмът е висок и корекциите стават по-вероятни. Обмислете намаляване на високорисковата експозиция."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimismus je zvýšený a korekce jsou pravděpodobnější. Zvažte snížení vysoce rizikové expozice."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimismen er høj, og tilbageslag bliver mere sandsynlige. Overvej at reducere højrisikopositioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stimmung ist sehr optimistisch und Rücksetzer werden wahrscheinlicher. Erwägen Sie, hochriskante Positionen zu reduzieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αισιοδοξία είναι αυξημένη και οι διορθώσεις γίνονται πιθανότερες. Σκεφτείτε να μειώσετε την έκθεση υψηλού κινδύνου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El optimismo es alto y las correcciones son más probables. Considera reducir la exposición de alto riesgo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimismia on paljon ja korjausliikkeet ovat todennäköisempiä. Harkitse suuren riskin pienentämistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’optimisme est élevé et les replis deviennent plus probables. Envisagez de réduire l’exposition à haut risque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האופטימיות גבוהה ותיקונים סבירים יותר. שקלו להפחית חשיפה בסיכון גבוה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आशावाद बढ़ा है और गिरावट की संभावना अधिक है। उच्च जोखिम कम करने पर विचार करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizam je povišen i povlačenja postaju vjerojatnija. Razmislite o smanjenju visokorizične izloženosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az optimizmus magas, a korrekciók valószínűbbek. Fontolja meg a magas kockázat csökkentését."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimisme tinggi dan koreksi menjadi lebih mungkin. Pertimbangkan mengurangi eksposur berisiko tinggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ottimismo è elevato e i ritracciamenti sono più probabili. Valuta di ridurre l’esposizione ad alto rischio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "楽観が強く、押し目が起きやすくなっています。高リスクのエクスポージャーを減らすことを検討してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낙관론이 높고 조정이 더 잦아질 수 있습니다. 고위험 노출을 줄이는 것을 고려하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizmas padidėjęs, o korekcijos tampa labiau tikėtinos. Apsvarstykite didelės rizikos mažinimą."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimismen er høy, og tilbakefall blir mer sannsynlige. Vurder å redusere høyrisikoeksponering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het optimisme is hoog en terugvallen worden waarschijnlijker. Overweeg de blootstelling aan hoog risico te verkleinen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optymizm jest wysoki, a korekty stają się bardziej prawdopodobne. Rozważ ograniczenie ekspozycji wysokiego ryzyka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O otimismo está elevado e as correções ficam mais prováveis. Considere reduzir a exposição de alto risco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimismul este ridicat, iar corecțiile devin mai probabile. Luați în calcul reducerea expunerii cu risc ridicat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимизм высок, и откаты становятся вероятнее. Подумайте о снижении высокорисковой доли."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizmus je zvýšený a korekcie sú pravdepodobnejšie. Zvážte zníženie vysoko rizikovej expozície."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimizem je povišan in popravki so verjetnejši. Razmislite o zmanjšanju visoko tvegane izpostavljenosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimism är hög och rekyler blir mer sannolika. Överväg att minska exponeringen med hög risk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความมองโลกในแง่ดีสูงและการย่อตัวมีโอกาสมากขึ้น พิจารณาลดความเสี่ยงสูง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İyimserlik yüksek ve geri çekilmeler daha olası. Yüksek riskli pozisyonu azaltmayı düşünün."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимізм високий, і відкати стають імовірнішими. Подумайте про зменшення високоризикової частки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự lạc quan đang cao và điều chỉnh dễ xảy ra hơn. Hãy cân nhắc giảm mức rủi ro cao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "乐观情绪偏高，回调更可能出现。考虑降低高风险敞口。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "樂觀情緒偏高，回檔更可能出現。考慮降低高風險敞口。"
          }
        }
      }
    },

    "Transactions are cheaper than usual. Most actions should confirm quickly at low cost." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعاملات أرخص من المعتاد. يُفترض أن تتأكد معظم الإجراءات بسرعة وبتكلفة منخفضة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трансакциите са по-евтини от обичайното. Повечето действия би трябвало да се потвърдят бързо и евтино."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transakce jsou levnější než obvykle. Většina akcí by se měla rychle potvrdit za nízkou cenu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaktioner er billigere end normalt. De fleste handlinger bør bekræftes hurtigt til lav pris."
          }
        },
        "de" : {

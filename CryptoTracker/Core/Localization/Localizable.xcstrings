    "Sentiment is balanced with no strong trend direction. Watch for momentum shifts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعنويات متوازنة دون اتجاه قوي. راقب تحولات الزخم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настроението е балансирано, без силна посока. Следете за промяна в импулса."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentiment je vyrovnaný bez silného směru. Sledujte změny momenta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemningen er afbalanceret uden stærk retning. Hold øje med skift i momentum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Stimmung ist ausgeglichen, ohne klare Richtung. Achten Sie auf Momentumwechsel."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το συναίσθημα είναι ισορροπημένο χωρίς ισχυρή κατεύθυνση. Παρακολουθήστε τις αλλαγές ορμής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sentimiento está equilibrado, sin una dirección clara. Vigila los cambios de impulso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnemaailma on tasapainossa ilman vahvaa suuntaa. Seuraa momentumin muutoksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sentiment est équilibré, sans direction marquée. Surveillez les changements de dynamique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסנטימנט מאוזן בלי כיוון חזק. עקבו אחרי שינויי מומנטום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भावना संतुलित है, कोई मजबूत दिशा नहीं। गति में बदलाव देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raspoloženje je uravnoteženo bez jakog smjera. Pratite promjene zamaha."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangulat kiegyensúlyozott, nincs erős irány. Figyelje a lendület változását."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentimen seimbang tanpa arah yang kuat. Perhatikan perubahan momentum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sentiment è equilibrato, senza una direzione forte. Osserva i cambi di momentum."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センチメントは均衡し、強い方向性はありません。モメンタムの変化に注意してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심리가 균형을 이루고 뚜렷한 방향이 없습니다. 모멘텀 변화를 살피세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",

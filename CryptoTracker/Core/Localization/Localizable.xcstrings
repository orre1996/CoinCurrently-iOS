    "Something went wrong. Make sure Face ID/Touch ID is enabled and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ ما. تأكد من تفعيل Face ID أو Touch ID ثم أعد المحاولة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нещо се обърка. Уверете се, че Face ID или Touch ID е включено, и опитайте отново."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco se pokazilo. Zkontrolujte, že je Face ID nebo Touch ID zapnuté, a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget gik galt. Sørg for, at Face ID eller Touch ID er slået til, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas ist schiefgelaufen. Stelle sicher, dass Face ID oder Touch ID aktiv ist, und versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτι πήγε στραβά. Βεβαιώσου ότι το Face ID ή το Touch ID είναι ενεργό και δοκίμασε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

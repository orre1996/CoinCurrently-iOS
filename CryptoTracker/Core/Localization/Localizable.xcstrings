        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenligner Bitcoins nylige volatilitet og fall med 30- og 90-dagers snitt. Høyere volatilitet signaliserer ofte frykt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijkt de recente volatiliteit en dalingen van Bitcoin met de gemiddelden over 30 en 90 dagen. Hogere volatiliteit wijst vaak op angst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównuje niedawną zmienność i spadki Bitcoina ze średnimi z 30 i 90 dni. Wyższa zmienność często oznacza strach."

        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokin meni pieleen. Varmista, että Face ID tai Touch ID on käytössä, ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

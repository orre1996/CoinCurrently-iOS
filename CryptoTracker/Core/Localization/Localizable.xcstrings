    "Double tap for %@ details. Long press for more options" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مرتين لتفاصيل %@. اضغط مطولًا لمزيد من الخيارات"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете два пъти за подробности за %@. Натиснете продължително за още опции"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojitým klepnutím zobrazíte podrobnosti o %@. Dlouhým stiskem další možnosti"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbelttryk for detaljer om %@. Hold nede for flere muligheder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen für Details zu %@. Gedrückt halten für weitere Optionen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε δύο φορές για λεπτομέρειες %@. Πατήστε παρατεταμένα για περισσότερες επιλογές"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para ver detalles de %@. Mantén pulsado para más opciones"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa kohteen %@ tiedot kaksoisnapauttamalla. Lisää valintoja pitkällä painalluksella"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour les détails de %@. Appuyez longuement pour plus d’options"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקש פעמיים לפרטי %@. לחץ לחיצה ארוכה לאפשרויות נוספות"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ का विवरण देखने के लिए दो बार टैप करें। अधिक विकल्पों के लिए देर तक दबाएँ"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite dvaput za pojedinosti o %@. Dugo pritisnite za više opcija"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson duplán a(z) %@ részleteiért. Tartsa lenyomva a további lehetőségekért"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk dua kali untuk detail %@. Tekan lama untuk opsi lainnya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte per i dettagli di %@. Tieni premuto per altre opzioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップで%@の詳細を表示。長押しでその他のオプション"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번 탭하면 %@ 상세 정보를 봅니다. 길게 누르면 더 많은 옵션이 나옵니다"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukart bakstelėkite, kad pamatytumėte %@ informaciją. Ilgai paspauskite, kad pamatytumėte daugiau parinkčių"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbelttrykk for detaljer om %@. Hold inne for flere valg"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik dubbel voor details van %@. Houd ingedrukt voor meer opties"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dwukrotnie, aby zobaczyć szczegóły %@. Przytrzymaj, aby zobaczyć więcej opcji"

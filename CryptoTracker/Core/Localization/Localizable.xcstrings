          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakupa ni bilo mogoče preveriti. Če preizkušate v Xcodu, naložite javno potrdilo StoreKit v RevenueCat ali preizkusite na napravi z računom Apple Sandbox."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köpet kunde inte verifieras. Om du testar i Xcode, ladda upp ditt offentliga StoreKit-certifikat till RevenueCat eller testa på en enhet med ett Apple Sandbox-konto."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยืนยันการซื้อไม่ได้ หากคุณทดสอบใน Xcode ให้อัปโหลดใบรับรองสาธารณะของ StoreKit ไปยัง RevenueCat หรือทดสอบบนอุปกรณ์ที่มีบัญชี Apple แบบ Sandbox"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın alma doğrulanamadı. Xcode’da test ediyorsanız StoreKit genel sertifikasını RevenueCat’e yükleyin veya Sandbox Apple Hesabı olan bir cihazda test edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося перевірити покупку. Якщо ви тестуєте в Xcode, завантажте публічний сертифікат StoreKit у RevenueCat або тестуйте на пристрої з пісочним обліковим записом Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xác minh giao dịch. Nếu bạn đang thử trong Xcode, hãy tải chứng chỉ công khai của StoreKit lên RevenueCat hoặc thử trên thiết bị có tài khoản Apple Sandbox."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法验证购买。如果在 Xcode 中测试，请将 StoreKit 公钥证书上传到 RevenueCat，或在使用沙盒 Apple 账户的设备上测试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法驗證購買。如果在 Xcode 中測試，請將 StoreKit 公鑰憑證上傳到 RevenueCat，或在使用沙盒 Apple 帳號的裝置上測試。"
          }
        }
      }
    },

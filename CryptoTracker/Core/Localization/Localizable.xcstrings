    "Category filter. Swipe up or down to change category." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفية الفئات. اسحب لأعلى أو لأسفل لتغيير الفئة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Филтър за категории. Плъзнете нагоре или надолу, за да смените категорията."
          }
        },
        "cs" : {
          "stringUnit" : {

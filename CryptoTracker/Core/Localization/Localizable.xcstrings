    "Expect expensive fees and slower confirmations unless prioritized. Network congestion is heavy." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقع رسومًا مرتفعة وتأكيدات أبطأ ما لم تُعطَ أولوية. ازدحام الشبكة شديد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очаквайте скъпи такси и по-бавни потвърждения, освен ако не се приоритизира. Мрежата е силно натоварена."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Očekávejte drahé poplatky a pomalejší potvrzení, pokud transakci neupřednostníte. Síť je silně přetížená."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forvent dyre gebyrer og langsommere bekræftelser, medmindre de prioriteres. Netværket er stærkt belastet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erwarten Sie hohe Gebühren und langsamere Bestätigungen, sofern nicht priorisiert. Das Netzwerk ist stark ausgelastet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναμένετε ακριβές χρεώσεις και πιο αργές επιβεβαιώσεις, εκτός αν δοθεί προτεραιότητα. Η συμφόρηση είναι έντονη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere comisiones caras y confirmaciones más lentas salvo que se prioricen. La congestión de la red es alta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odota kalliita maksuja ja hitaampia vahvistuksia, ellei tapahtumaa priorisoida. Verkko on pahasti ruuhkautunut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez-vous à des frais élevés et à des confirmations plus lentes, sauf priorité. Le réseau est très congestionné."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צפו לעמלות יקרות ולאישורים איטיים יותר אלא אם תינתן עדיפות. העומס ברשת כבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महंगे शुल्क और धीमी पुष्टि की उम्मीद करें, जब तक प्राथमिकता न दी जाए। नेटवर्क भीड़भाड़ बहुत अधिक है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Očekujte skupe naknade i sporije potvrde osim ako se dade prioritet. Zagušenje mreže je veliko."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drága díjakra és lassabb megerősítésre számítson, hacsak nincs priorizálva. A hálózat erősen túlterhelt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkirakan biaya mahal dan konfirmasi lebih lambat kecuali diprioritaskan. Kemacetan jaringan tinggi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aspettati commissioni care e conferme più lente, salvo priorità. La congestione della rete è elevata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "優先しない限り、高い料金と遅い確定が予想されます。ネットワークの混雑が深刻です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "우선순위를 높이지 않으면 비싼 수수료와 느린 확정이 예상됩니다. 네트워크 혼잡이 심합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikėkitės brangių mokesčių ir lėtesnių patvirtinimų, nebent suteiksite prioritetą. Tinklas stipriai apkrautas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forvent dyre gebyrer og tregere bekreftelser med mindre de prioriteres. Nettverket er sterkt belastet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reken op hoge kosten en tragere bevestigingen, tenzij je prioriteit geeft. Het netwerk is zwaar belast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spodziewaj się wysokich opłat i wolniejszych potwierdzeń, chyba że nadasz priorytet. Sieć jest mocno przeciążona."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere taxas caras e confirmações mais lentas, a menos que sejam priorizadas. O congestionamento da rede é alto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Așteptați comisioane scumpe și confirmări mai lente, dacă nu sunt prioritizate. Congestia rețelei este mare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидайте дорогие комиссии и более медленные подтверждения, если не задать приоритет. Сеть сильно перегружена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Očakávajte drahé poplatky a pomalšie potvrdenia, ak transakciu neuprednostníte. Sieť je silno preťažená."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pričakujte drage pristojbine in počasnejše potrditve, razen če daste prednost. Zastoj omrežja je velik."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räkna med dyra avgifter och långsammare bekräftelser om de inte prioriteras. Nätverket är hårt belastat."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คาดว่าค่าธรรมเนียมแพงและการยืนยันช้าลงหากไม่จัดลำดับความสำคัญ ความหนาแน่นของเครือข่ายสูง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öncelik verilmezse pahalı ücretler ve daha yavaş onaylar bekleyin. Ağ tıkanıklığı yüksek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очікуйте дорогі комісії та повільніші підтвердження, якщо не задати пріоритет. Перевантаження мережі значне."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phí sẽ đắt và xác nhận chậm hơn nếu không ưu tiên. Mạng đang tắc nghẽn nặng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非提高优先级，否则费用很高且确认更慢。网络拥堵严重。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非提高優先級，否則費用很高且確認更慢。網路壅塞嚴重。"
          }
        }
      }
    },

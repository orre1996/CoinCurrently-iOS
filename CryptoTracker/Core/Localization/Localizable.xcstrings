          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取引は非常に安価です。スワップ、送金、コントラクト操作に最適なタイミングです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "거래 수수료가 매우 저렴합니다. 스왑, 전송, 컨트랙트 상호작용에 이상적인 시점입니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",

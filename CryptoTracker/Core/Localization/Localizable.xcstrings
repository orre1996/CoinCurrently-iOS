        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코인의 별표를 탭하면 여기에 추가하고 쉽게 추적할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakstelėkite monetos žvaigždutę, kad ją pridėtumėte čia ir lengvai sektumėte."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på stjernen ved en mynt for å legge den til her og følge den enkelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op de ster bij een munt om deze hier toe te voegen en eenvoudig te volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij gwiazdkę przy monecie, aby dodać ją tutaj i łatwo śledzić."

        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitora la quota di Bitcoin sulla capitalizzazione totale del mercato crypto. Una dominanza più alta suggerisce uno spostamento verso asset più sicuri."
